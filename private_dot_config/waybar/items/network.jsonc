{
  "network": {
    "format": "<span size='small' rise='2pt'>{icon}</span>",
    "format-wifi": "<span size='small' rise='2pt'>{icon}</span>",
    "format-ethernet": "<span size='small' rise='2pt'>{icon}</span>",
    "tooltip-format": "{essid}: {signalStrength}%",
    "tooltip-format-ethernet": "Connected via Ethernet: {ipaddr}",
    "tooltip-format-disconnected": "Not connected",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "󰅛",
    // "format-alt": "{icon} {ipaddr}",
    "format-icons": {
      "default": "󰈀",
      "wifi": [
        "󰤯",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": "󰈀"
    },
    "on-click": "pkill nm-connection-e || nm-connection-editor"
  }
}

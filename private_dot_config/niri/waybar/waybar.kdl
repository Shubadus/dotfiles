spawn-at-startup "waybar" // &> ~/.local/share/waybar.log"
spawn-at-startup "hypridle"
spawn-at-startup "swww-daemon"
spawn-at-startup "dunst"
spawn-at-startup "~/.local/bin/scripts/window_manager/apply_gtk_theme.sh"

binds {
    Alt+Space hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    Ctrl+Shift+L hotkey-overlay-title="Lock the Screen: hyprlock" { spawn "hyprlock"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "~/.local/bin/scripts/window_manager/volume.py" "-v" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "~/.local/bin/scripts/window_manager/volume.py" "-v" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "~/.local/bin/scripts/window_manager/volume.py" "-v" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    Mod+X           { spawn "~/.local/bin/scripts/window_manager/powermenu.sh"; }
}

// Open Apps in the Top-Right for Waybar
window-rule {
  match app-id="org.pulseaudio.pavucontrol"
  match app-id="nm-connection-editor"
  match app-id="gpauth"

  open-floating true
  open-focused true

  // focus-ring {
  //   width 2 
  // }

  default-column-width { proportion 0.2; }
  default-window-height { proportion 0.4; }

  default-floating-position x=8 y=8 relative-to="top-right"
}
// Open Apps in the Top-Right for Waybar
window-rule {
  match app-id="weather"

  open-floating true
  open-focused true

  // focus-ring {
  //   width 2 
  // }

  default-column-width { fixed 1200; }
  default-window-height { fixed 900; }

  default-floating-position x=8 y=8 relative-to="top-left"
}

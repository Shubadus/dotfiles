layout {
    background-color "transparent"

    focus-ring {
        active-color   "#a7c8ff"
        inactive-color "#8e9199"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a7c8ff"
        inactive-color "#33353a"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a7c8ff"
        inactive-color "#04305f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a7c8ff80"
    }
}

overview {
  workspace-shadow {
    color "#bdc7dc"
  }
}


